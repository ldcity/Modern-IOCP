{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-release",
      "displayName": "x64 Release (PDB 포함)",
      "description": "S1 의 정본 preset. build / verify-dump / CI / VS 열기 전부 이것을 쓴다.",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64,version=10.0.26100.0",
        "strategy": "set"
      },
      "toolset": {
        "value": "v145,version=14.51",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/x64-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "x64-release-ci",
      "displayName": "x64 Release (CI)",
      "description": "GitHub Actions 러너용. 툴체인은 x64-release 를 상속해 로컬과 같게 두고 build 디렉터리만 분리한다.",
      "inherits": "x64-release",
      "binaryDir": "${sourceDir}/build/x64-release-ci"
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-release-ci",
      "configurePreset": "x64-release-ci",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-release-ci",
      "configurePreset": "x64-release-ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
